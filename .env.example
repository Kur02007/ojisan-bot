# Do not use production credentials for local tests. Empty means unconfigured.
DISCORD_BOT_TOKEN=
ADMIN_DISCORD_USER_ID=0
ADMIN_API_KEY=
POSTGRES_USER=ojisan
POSTGRES_DB=ojisan
POSTGRES_PASSWORD=
# URL-encode the password when constructing DATABASE_URL.
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
CALLBACK_URL=https://example.invalid/webhook/youtube
YOUTUBE_WEBHOOK_SECRET=
YOUTUBE_API_KEY=
MAX_CHANNELS_PER_GUILD=20
ENABLE_LIVE_POLLING=true
ENABLE_RAW_FEED_LOGS=false
LIVE_POLL_INTERVAL_SECONDS=45
# Optional: all four required to enable Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=
TWITCH_CALLBACK_URL=
